# =========================================
# APPLICATION
# =========================================
APP_NAME=SupplyChain Guardian
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_in_production

# =========================================
# SERVER
# =========================================
HOST=0.0.0.0
PORT=8000

# =========================================
# POSTGRESQL
# =========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supplychain_guardian
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/supplychain_guardian

# =========================================
# REDIS
# =========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# =========================================
# QDRANT
# =========================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=supplier_profiles

# =========================================
# LLM CONFIG
# =========================================
LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =========================================
# EXTERNAL DATA SOURCES
# =========================================

# Open Meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# GDELT
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2

# Finnhub
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# ShipBob
SHIPBOB_API_KEY=
SHIPBOB_BASE_URL=https://api.shipbob.com/1.0

# World Bank WITS
WITS_BASE_URL=https://wits.worldbank.org/API/V1

# =========================================
# SENDGRID
# =========================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=procurement@scg.internal

# =========================================
# SLACK
# =========================================
SLACK_BOT_TOKEN=
SLACK_APPROVAL_CHANNEL=#procurement-approvals

# =========================================
# SECURITY / APPROVALS
# =========================================
AUTO_APPROVAL_MAX_COST_DELTA=25
AUTO_APPROVAL_MIN_CONFIDENCE=0.60
AUTO_APPROVAL_MAX_RESIDUAL_RISK=49
AUTO_APPROVAL_MAX_ONBOARDING_WEEKS=2

# =========================================
# CACHING TTLs (seconds)
# =========================================
WEATHER_CACHE_TTL=600
FINANCIAL_CACHE_TTL=14400
LOGISTICS_CACHE_TTL=1800
GEOPOLITICAL_CACHE_TTL=3600
TARIFF_CACHE_TTL=86400

# =========================================
# FEATURE FLAGS
# =========================================
MVP_MODE=true
ENABLE_EMAIL_DISPATCH=false
ENABLE_BACKGROUND_JOBS=true
ENABLE_VECTOR_SEARCH=true

# =========================================
# LOGGING
# =========================================
LOG_LEVEL=INFO